# YetiLink CLI Dojo — Shell Configuration (.zshrc)

# 1. Environment & Paths
export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export TZ=UTC
export PATH="$HOME/bin:/opt/dojo/bin:$PATH"

# 2. History Configuration (50k lines, shared, deduped)
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_SAVE_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt INC_APPEND_HISTORY

# 3. Completion System
autoload -Uz compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
compinit -d "$HOME/.zcompdump"

# 4. Allowed Shims & Aliases (Strictly no shadowing of core commands)
alias bat='batcat'
alias fd='fdfind'

# 5. FZF Integration
if [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]; then
    source /usr/share/doc/fzf/examples/key-bindings.zsh
fi
if [ -f /usr/share/doc/fzf/examples/completion.zsh ]; then
    source /usr/share/doc/fzf/examples/completion.zsh
fi

# 6. Starship Prompt
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# 7. Zsh Autosuggestions
if [ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=244'
fi

# 8. Zsh Syntax Highlighting (MUST BE SOURCED LAST)
if [ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# 9. MOTD Banner on first interactive login
if [[ -o interactive ]] && [[ -t 1 ]]; then
    if [[ ! -f "$HOME/.dojo/.motd_shown" ]]; then
        mkdir -p "$HOME/.dojo"
        if [ -f "$HOME/.config/motd.txt" ]; then
            cat "$HOME/.config/motd.txt"
        elif [ -f /etc/skel-dojo/.config/motd.txt ]; then
            cat /etc/skel-dojo/.config/motd.txt
        elif [ -f /opt/dojo/config/motd.txt ]; then
            cat /opt/dojo/config/motd.txt
        fi
        touch "$HOME/.dojo/.motd_shown"
    fi
fi
