#!/usr/bin/env bash
# YetiLink CLI Dojo — Exercise Setup Runner (dojo-setup)
# Must run as root (whitelisted in sudoers for student)
set -euo pipefail

# Sourcing common libraries
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
LIB_DIR="$(cd "${SCRIPT_DIR}/../lib" && pwd)"
# shellcheck source=/dev/null
source "${LIB_DIR}/common.sh"
# shellcheck source=/dev/null
source "${LIB_DIR}/seed.sh"

if [[ $# -lt 1 || $# -gt 2 ]]; then
    die "Usage: dojo-setup <NN> [SEED]"
fi

RAW_ID="$1"
if [[ ! "$RAW_ID" =~ ^[0-9]{2}$ ]]; then
    die "Invalid exercise ID format: '$RAW_ID'. Must be exactly two digits (00-20)."
fi

EX_ID="$RAW_ID"
EX_DIR="$(get_exercise_dir "$EX_ID")"
EX_SLUG="$(basename "$EX_DIR")"

# State directory setup
STATE_DIR="/opt/dojo/state"
mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"
chown root:root "$STATE_DIR"

# Determine seed
if [[ $# -eq 2 && -n "$2" ]]; then
    SEED="$2"
else
    # 6-digit random positive integer
    SEED="$(( (RANDOM << 15 | RANDOM) % 900000 + 100000 ))"
fi

# Write seed to protected state file
SEED_FILE="${STATE_DIR}/${EX_ID}.seed"
echo "$SEED" > "$SEED_FILE"
chmod 600 "$SEED_FILE"
chown root:root "$SEED_FILE"

# Prepare student workdir
STUDENT_HOME="/home/student"
WORK="${STUDENT_HOME}/dojo/${EX_SLUG}"

rm -rf "$WORK"
mkdir -p "$WORK"

# Run the exercise setup script
if [[ -f "${EX_DIR}/setup.sh" ]]; then
    export SEED
    export WORK
    export EX_ID
    export EX_SLUG
    (
        cd "$WORK"
        bash "${EX_DIR}/setup.sh"
    )
fi

# Ensure student owns the workdir
if id "student" >/dev/null 2>&1; then
    chown -R student:student "$WORK"
    chmod 755 "$WORK"
fi

# Update progress.json: mark as started
update_progress "$EX_ID" '.status = (if .status == "passed" then "passed" else "started" end) | .hints = (.hints // 0) | .solution_viewed = (.solution_viewed // false) | .attempts = (.attempts // 0)'

exit 0
